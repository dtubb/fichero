# macOS clutter
.DS_Store
**/.DS_Store

# Built-in default overrides
**/node_modules/
**/.git/
**/__pycache__/
**/.trace-mcp/
**/vendor/

# Python environment & tooling caches
.venv/
venv/
**/.venv/
**/venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
