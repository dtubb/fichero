**/.ruff_cache/
**/.mypy_cache/
*.egg-info/
**/*.egg-info/

# Build artifacts — these contain a bundled Python.framework (~500MB)
# which crashed earlier indexing runs
build/
dist/
**/build/
**/dist/

# Archived / quarantined tests
tests/unit/_archived/

# Logs and eval scratch
logs/
evals/.cache/
