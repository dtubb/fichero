{
  "name": "Catalogue Stage 2 - Extract Entities + KG",
  "description": "Stage 2 of the reviewable catalogue pipeline. Read existing page text, extract per-page entities with the $small model alias, persist entity artifacts, and write factual KG claims inline during extraction. This is intended for imported pages that already have transcripts or pages that completed Stage 1.",
  "format": "nodes",
  "is_template": true,
  "is_system": true,
  "folder_path": "/Catalogue",
  "tags": [
    "preset",
    "catalogue",
    "stage",
    "entities",
    "kg",
    "reviewable"
  ],
  "config": {
    "preset_version": 2,
    "stage": "entities_kg"
  },
  "nodes": [
    {
      "id": "files-source",
      "tool": "files",
      "label": "Files with text",
      "position_x": 80,
      "position_y": 220,
      "inputs": {},
      "config": {}
    },
    {
      "id": "aggregate_text",
      "tool": "aggregate",
      "label": "Collect page text",
      "position_x": 260,
      "position_y": 220,
      "inputs": {},
      "config": {
        "mode": "concat",
        "separator": "\n\n---\n\n"
      }
    },
    {
      "id": "extract_all",
      "tool": "extract_all",
      "label": "Extract entities",
      "position_x": 460,
      "position_y": 220,
      "inputs": {},
      "config": {
        "output_language": "auto",
        "provider_name": "$small",
        "persist_kg": true
      }
    }
  ],
  "edges": [
    {
      "id": "e-files-aggregate-documents",
      "source": "files-source",
      "target": "aggregate_text",
      "source_port": "documents",
      "target_port": "documents"
    },
    {
      "id": "e-aggregate-extract-text",
      "source": "aggregate_text",
      "target": "extract_all",
      "source_port": "text",
      "target_port": "text"
    },
    {
      "id": "e-aggregate-extract-records",
      "source": "aggregate_text",
      "target": "extract_all",
      "source_port": "records",
      "target_port": "records"
    }
  ]
}
