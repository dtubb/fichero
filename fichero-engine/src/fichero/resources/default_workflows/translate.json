{
  "name": "Translate",
  "description": "Transcribe each file (reusing any existing text layer), then translate the extracted text using DeepL. Source language (auto) and target language (en by default) are editable on the Translate node.",
  "format": "nodes",
  "is_template": true,
  "is_system": true,
  "folder_path": "/Translate",
  "tags": ["preset", "translate", "text", "language", "small"],
  "config": {
    "preset_version": 1
  },
  "nodes": [
    {
      "id": "files-source",
      "tool": "files",
      "label": "Files",
      "position_x": 80,
      "position_y": 200,
      "inputs": {},
      "config": {}
    },
    {
      "id": "transcribe",
      "tool": "transcribe",
      "label": "Transcribe each file",
      "position_x": 280,
      "position_y": 200,
      "inputs": {},
      "config": {
        "vision_mode": "auto",
        "language": "auto",
        "update_page_content": true
      }
    },
    {
      "id": "translate",
      "tool": "translate",
      "label": "Translate Text",
      "position_x": 480,
      "position_y": 200,
      "inputs": {},
      "config": {
        "provider_name": "deepl",
        "model_name": "deepl-default",
        "target_lang": "en",
        "source_lang": "auto"
      }
    }
  ],
  "edges": [
    {
      "id": "edge-files-transcribe",
      "source": "files-source",
      "target": "transcribe",
      "source_port": "files",
      "target_port": "files"
    },
    {
      "id": "edge-transcribe-translate",
      "source": "transcribe",
      "target": "translate",
      "source_port": "text",
      "target_port": "text"
    }
  ]
}
