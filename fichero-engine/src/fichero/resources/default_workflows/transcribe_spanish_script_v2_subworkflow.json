{
  "name": "Transcribe Spanish Script v2 (19th-20th C., Sub-Workflow)",
  "description": "Parent Spanish Script preset that composes the reusable v2 child workflow through a typed sub_workflow node. The child owns draft, review, and final vision-tier passes; this parent exposes a simple files-in, text-out workflow for the Run menu.",
  "format": "nodes",
  "is_template": true,
  "is_system": true,
  "folder_path": "/Transcribe",
  "tags": [
    "preset",
    "transcribe",
    "spanish",
    "script",
    "notarial",
    "multi-pass",
    "sub-workflow",
    "v2"
  ],
  "config": {
    "preset_version": 1
  },
  "nodes": [
    {
      "id": "files-source",
      "tool": "files",
      "label": "Files",
      "position_x": 80,
      "position_y": 260,
      "inputs": {},
      "config": {}
    },
    {
      "id": "spanish-script-v2",
      "tool": "sub_workflow",
      "label": "Spanish Script v2",
      "position_x": 340,
      "position_y": 260,
      "inputs": {},
      "config": {
        "workflow_ref": "Spanish Script v2 Child Passes (19th-20th C.)",
        "input_contract": [
          {
            "id": "files",
            "data_type": "files",
            "required": true,
            "description": "Selected page image paths to transcribe."
          }
        ],
        "output_contract": [
          {
            "id": "text",
            "data_type": "text",
            "required": true,
            "description": "Final reconciled transcription text."
          }
        ],
        "output_mapping": {
          "text": "$.nodes.transcribe-final-large.text"
        },
        "max_depth": 4,
        "allow_partial": false
      }
    }
  ],
  "edges": [
    {
      "id": "edge-files-subworkflow",
      "source": "files-source",
      "target": "spanish-script-v2",
      "source_port": "files",
      "target_port": "files"
    }
  ]
}
