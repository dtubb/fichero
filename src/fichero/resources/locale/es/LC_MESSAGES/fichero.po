# Add Window
msgid "Add to Library"
msgstr "Agregar a la Biblioteca"

msgid "Add URL"
msgstr "Agregar URL"

msgid "Add content from a web URL"
msgstr "Agregar contenido desde una URL web"

msgid "Add Website"
msgstr "Agregar Sitio Web"

msgid "Browse and add content from websites"
msgstr "Navegar y agregar contenido desde sitios web"

msgid "Add File"
msgstr "Agregar Archivo"

msgid "Add files from your computer"
msgstr "Agregar archivos desde tu computadora"

msgid "Add Folder"
msgstr "Agregar Carpeta"

msgid "Add entire folders to your library"
msgstr "Agregar carpetas completas a tu biblioteca"

msgid "Add Picture"
msgstr "Agregar Foto"

msgid "Take a photo with your camera"
msgstr "Tomar una foto con tu cámara"

msgid "Add Audio Recording"
msgstr "Agregar Grabación de Audio"

msgid "Record audio to add to your library"
msgstr "Grabar audio para agregar a tu biblioteca"

# File Selector
msgid "Select Files to Add to Library"
msgstr "Seleccionar Archivos para Agregar a la Biblioteca"

msgid "Select Files"
msgstr "Seleccionar Archivos"

msgid "No files selected"
msgstr "No hay archivos seleccionados"

msgid "%(count)d files selected"
msgstr "%(count)d archivos seleccionados"

# Folder Selector
msgid "Select Folders to Add to Library"
msgstr "Seleccionar Carpetas para Agregar a la Biblioteca"

msgid "Select Folders"
msgstr "Seleccionar Carpetas"

msgid "No folders selected"
msgstr "No hay carpetas seleccionadas"

msgid "1 folder selected"
msgstr "1 carpeta seleccionada"

msgid "%(count)d folders selected"
msgstr "%(count)d carpetas seleccionadas"

# Camera Selector
msgid "📷 Take Photo"
msgstr "📷 Tomar Foto"

msgid "Ready to take photo"
msgstr "Listo para tomar foto"

msgid "Taking photo..."
msgstr "Tomando foto..."

msgid "Photo captured successfully"
msgstr "Foto capturada exitosamente"

msgid "Photo capture failed or cancelled"
msgstr "Captura de foto falló o fue cancelada"

# URL Selector
msgid "Single URL"
msgstr "URL Individual"

msgid "Multiple URLs"
msgstr "URLs Múltiples"

msgid "Enter URL (e.g., https://example.com)..."
msgstr "Ingresar URL (ej., https://ejemplo.com)..."

msgid "Enter multiple URLs (one per line):"
msgstr "Ingresar múltiples URLs (una por línea):"

msgid "https://example1.com\nhttps://example2.com\n..."
msgstr "https://ejemplo1.com\nhttps://ejemplo2.com\n..."

msgid "Add URLs"
msgstr "Agregar URLs"

# Website Selector
msgid "Enter website URL (e.g., https://example.com)..."
msgstr "Ingresar URL del sitio web (ej., https://ejemplo.com)..."

msgid "Go"
msgstr "Ir"

msgid "Select"
msgstr "Seleccionar"

msgid "WebView not available on this platform"
msgstr "WebView no disponible en esta plataforma"

msgid "Navigate to a website and click 'Select' to add its content to your library."
msgstr "Navega a un sitio web y haz clic en 'Seleccionar' para agregar su contenido a tu biblioteca."

