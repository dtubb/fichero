<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS and iPad only (the SDK-conditional CODE_SIGN_ENTITLEMENTS in the Fichero target). The Mac files carry the sandbox keys
  and no Associated Domains, whose profile the Mac App Store profile does not hold. The universal pairing link
  https://tubb.ca/apps/fichero/pair opens the app through this (`sharing.ios-link-opened-from-messages`, #5049); the
  apple-app-site-association is served from tubb.ca (owner ruling 2026-11-02).
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:tubb.ca</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.fichero.fichero</string>
	</array>
</dict>
</plist>
