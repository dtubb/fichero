<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Developer ID / DMG channel app entitlements. The app is SANDBOXED in these
  configs via the ENABLE_APP_SANDBOX build setting (2026-07-29), so it needs
  the same bookmark rights the MAS file carries: `files.bookmarks.app-scope`
  is what permits MINTING app-scoped security-scoped bookmarks at all —
  without it the app minted bookmarks it was not entitled to mint, and the
  engine failed to resolve every one of them (NSCocoaError 259, engine
  sandbox P0 plan, 2026-08-08).

  app-sandbox is declared HERE too (2026-08-27): the DMG lane re-signs the
  app with this raw file, and codesign REPLACES entitlements — so the
  ENABLE_APP_SANDBOX merge from the Xcode build was silently stripped and
  the shipped DMG ran UNSANDBOXED, keeping its data in a different
  Application Support than every Xcode build (Daniel's different-folders
  bug). One sandbox everywhere: same container, same bugs caught early.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.files.bookmarks.document-scope</key>
	<true/>
	<!--
	  Sparkle 2 under the sandbox (2026-09-04): a sandboxed app talks to its
	  own Installer.xpc/status services over mach lookups named
	  <bundle-id>-spks / <bundle-id>-spki. Without these exceptions the
	  update DOWNLOADS fine and then dies at "An error occurred while
	  launching the installer" — Daniel's first real Sparkle update, build 1
	  to build 2. LITERAL bundle id, not $(PRODUCT_BUNDLE_IDENTIFIER): the
	  DMG lane re-signs with this raw file and codesign substitutes nothing.
	-->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>app.fichero.fichero-spks</string>
		<string>app.fichero.fichero-spki</string>
	</array>
</dict>
</plist>
