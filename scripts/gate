#!/usr/bin/env bash
# scripts/gate — the ONE serialized harness for every heavy build/test
# invocation (human, agent, CI). #4244.
#
# Three memory-crash incidents shared one root cause: multiple heavy processes
# (xcodebuild + pytest + hosted suites) running unserialized and unbounded.
# Everything heavy now goes through this script:
#
#   gate build                       build-for-testing (FicheroTests), -jobs capped
#   gate unit [--area X|--filter P]  Swift unit tests: build phase THEN
#                                    test-without-building (never stacked)
#   gate engine [--area X|paths...]  backend pytest (default: unit + integration
#                                    + contracts; NEVER tests/perf — see gate perf)
#   gate part <area>                 ONE area, verified the way the release
#                                    gate verifies everything: lint + build +
#                                    tests + the perf ratchet (#4439)
#   gate perf [paths...]             backend perf/scale suite (tests/perf, ~35-40
#                                    min) — required for releases + nightly (#4271)
#   gate ui <testplan>               hosted UI suite via a test plan
#   gate embedded                    embedded-launch UX check
#   gate transport                   transport matrix (UDS/HTTPS/in-memory) #4245
#   gate coverage                    test-coverage gap ratchet
#   gate preflight                   free-space check only (no lock) — heavy
#                                    subcommands run it pre-lock and refuse
#                                    below GATE_MIN_FREE_GB (default 20) #4434
#   gate verify-all                  every leg, one summary table (#4251)
#   gate areas [name]                print the area table / one resolution
#   gate wrap -- <cmd...>            run an arbitrary heavy command under the gate
#   gate --self-test                 exercise lock, areas, watchdog w/ fake cmds
#
# Serialization: a GLOBAL flock on /tmp/fichero-gate.lock. A second caller
# waits (with a message naming the holder) or fails fast with --no-wait
# (exit 75, EX_TEMPFAIL). Nested gate calls (verify-all legs) re-enter via
# GATE_LOCK_HELD and do NOT deadlock.
#
# Watchdog (three independent triggers):
#   1. memory PRESSURE (kern.memorystatus_vm_pressure_level — RSS is a proven
#      liar): instant kill at level >= 4 (hard critical), two-strike kill at
#      level 3 (critical);
#   2. per-process FOOTPRINT ceiling: `footprint` (phys_footprint) sampled
#      over the whole gated process tree — any single process crossing
#      GATE_FOOTPRINT_MB (default 4096) kills the run. This is the guard for
#      the 15-17GB dirty-MALLOC_SMALL leak the Swift Testing phase produced
#      while pressure stayed nominal;
#   3. a per-run wall-clock timeout.
#
# `gate unit` runs XCTest and Swift Testing as SEPARATELY-bounded invocations
# (--phase xctest|swift-testing|all) so one leaking phase cannot ride on the
# other's budget.
#
# Test/dev seams (used by --self-test; harmless otherwise):
#   GATE_DRYRUN=1              print heavy commands instead of exec'ing them
#   GATE_LOCK_FILE=path        alternate lock file
#   GATE_WATCH_INTERVAL=s      watchdog sample interval (default 5)
#   GATE_FAKE_PRESSURE=f       read pressure level from file f (or literal int)
#   GATE_FAKE_FOOTPRINT_MB=f   read max tree footprint (MB) from file/literal
#   GATE_FOOTPRINT_MB=n        footprint ceiling in MB (default 4096, test phases)
#   GATE_FOOTPRINT_BUILD_MB=n  build-phase ceiling (default 8192 — compilers peak high)
#   GATE_TIMEOUT=s             override the per-run timeout
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT" || exit 2

LOCK_FILE="${GATE_LOCK_FILE:-/tmp/fichero-gate.lock}"
WATCH_INTERVAL="${GATE_WATCH_INTERVAL:-5}"
DRYRUN="${GATE_DRYRUN:-0}"

XCODE_PROJECT="fichero/fichero.xcodeproj"
UNIT_SCHEME="FicheroTests"
UI_SCHEME="Fichero (Dev Local)"
GATE_DERIVED="${GATE_DERIVED:-build/gate-derived}"
SWIFT_TESTS_DIR="fichero/fichero-tests"

# ---------------------------------------------------------------------------
# AREA TABLE (declarative — edit here, nothing else).
# Columns (|-separated):
#   area | Swift test-class filename PREFIXES under fichero/fichero-tests
#        | engine pytest path globs (space separated; may be empty)
# Swift prefixes resolve at run time by globbing <prefix>*.swift, so the table
# survives the ongoing fichero-tests reorganisation without maintenance.
# ---------------------------------------------------------------------------
area_table() {
  cat <<'EOF'
sidebar   | Sidebar,DocumentStore            |
ingest    | ImportService                    | fichero-server/tests/unit/importers/
search    | Search                           | fichero-server/tests/unit/search/
inspector | Inspector                        |
transport | Transport,Connection             | fichero-server/tests/integration/test_transport_matrix.py fichero-server/tests/integration/test_transport_round_trips.py
canvas    | Canvas,Spatial,Space             |
library   | Library,Document                 | fichero-server/tests/unit/api/
reader    | Reader,PDF,Preview,Image         |
workflow  | Workflow,Tool                    | fichero-server/tests/unit/workflows/
kg        | Entity,Claim,Knowledge,Citation  | fichero-server/tests/unit/kg/
chat      | Chat,Agent,Research              | fichero-server/tests/unit/api/routes/
toolbar   | Toolbar,ContentView,Shell        |
db        | Library,Storage                  | fichero-server/tests/unit/db/
auth      | Auth,Account,Pairing             | fichero-server/tests/unit/security/
EOF
}

die() { echo "gate: $*" >&2; exit 2; }

find_python() {
  if [[ -n "${PYTHON_BIN:-}" ]]; then echo "$PYTHON_BIN"; return; fi
  if [[ -x "$REPO_ROOT/.venv/bin/python" ]]; then echo "$REPO_ROOT/.venv/bin/python"; return; fi
  if [[ -x "$REPO_ROOT/scripts/find_project_python.sh" ]]; then
    "$REPO_ROOT/scripts/find_project_python.sh" . 2>/dev/null && return
  fi
  command -v python3
}

# --------------------------- free-space preflight (#4434) --------------------
# The 2026-07-30 session died at 100% disk: 77 GB of leaked pytest basetemps,
# discovered only when a 20-minute leg failed with 116 ENOSPC-shaped "test
# failures". Refuse to START a heavy run on a nearly-full volume instead — the
# failure becomes one loud line at second zero, before the lock is taken.
# GATE_MIN_FREE_GB overrides the threshold (also how the self-test drives it).
preflight_free_space() {
  local min_gb="${GATE_MIN_FREE_GB:-20}"
  local target free_kb free_gb rc=0
  for target in "$REPO_ROOT" "${TMPDIR:-/tmp}"; do
    free_kb=$(df -k "$target" 2>/dev/null | awk 'NR==2 {print $4}')
    [[ "$free_kb" =~ ^[0-9]+$ ]] || continue
    free_gb=$((free_kb / 1024 / 1024))
    if (( free_gb < min_gb )); then
      echo "gate: PREFLIGHT REFUSED — ${free_gb} GB free on the volume of ${target} (< ${min_gb} GB; override with GATE_MIN_FREE_GB)." >&2
      echo "gate: likely reclaim (#4434): \${TMPDIR}/pytest-of-$(whoami) leaked test basetemps — any engine-test run sweeps dead ones at startup, or remove dirs whose .lock names a dead pid." >&2
      rc=1
    fi
  done
  return $rc
}

# --------------------------- locking ---------------------------------------
# macOS ships no flock(1); acquire the lock in python and re-exec ourselves
# with the flocked fd inherited (a flock lives on the open file description,
# so it survives exec and releases automatically when this process exits).
acquire_lock_and_reexec() {
  GATE_SELF="$0" GATE_LOCK_TARGET="$LOCK_FILE" exec "$(command -v python3)" - "$@" <<'PY'
import fcntl, os, sys
lock_path = os.environ["GATE_LOCK_TARGET"]
self_path = os.environ["GATE_SELF"]
no_wait = os.environ.get("GATE_NO_WAIT") == "1"
fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o666)
def holder():
    try:
        with open(lock_path) as fh:
            return fh.read().strip() or "<unknown>"
    except OSError:
        return "<unknown>"
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except (BlockingIOError, OSError):
    if no_wait:
        print(f"gate: lock busy — held by [{holder()}] ({lock_path}). "
              "Re-run without --no-wait to queue.", file=sys.stderr)
        sys.exit(75)  # EX_TEMPFAIL
    print(f"gate: waiting for lock held by [{holder()}] ({lock_path}) ...",
          file=sys.stderr, flush=True)
    fcntl.flock(fd, fcntl.LOCK_EX)  # block until free
os.set_inheritable(fd, True)
os.environ["GATE_LOCK_HELD"] = str(fd)
os.execv(self_path, [self_path] + sys.argv[1:])
PY
}

announce_holder() {
  # Truncate-and-write the holder line; flock is on the inode, content is
  # advisory info for the "waiting for ..." message.
  echo "pid $$ · $(whoami) · gate ${*:-} · started $(date '+%H:%M:%S')" >"$LOCK_FILE" 2>/dev/null || true
}

# --------------------------- watchdog --------------------------------------
pressure_level() {
  local fake="${GATE_FAKE_PRESSURE:-}"
  if [[ -n "$fake" ]]; then
    if [[ -f "$fake" ]]; then cat "$fake" 2>/dev/null || echo 1; else echo "$fake"; fi
    return
  fi
  sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null || echo 1
}

# Every pid in the gated process tree (the child + all descendants).
proc_tree() {
  local pid="$1" c
  echo "$pid"
  for c in $(pgrep -P "$pid" 2>/dev/null); do proc_tree "$c"; done
}

# Max phys_footprint (MB) of any single process in the tree rooted at $1.
# Uses /usr/bin/footprint (real dirty+compressed footprint), NOT ps rss.
tree_max_footprint_mb() {
  local root="$1" fake="${GATE_FAKE_FOOTPRINT_MB:-}"
  if [[ -n "$fake" ]]; then
    if [[ -f "$fake" ]]; then cat "$fake" 2>/dev/null || echo 0; else echo "$fake"; fi
    return
  fi
  local pids max_bytes
  pids=($(proc_tree "$root"))
  max_bytes="$(footprint --noCategories -f bytes "${pids[@]}" 2>/dev/null \
    | awk '/phys_footprint:/ {if ($2+0 > m) m=$2+0} END {print m+0}')"
  echo $(( ${max_bytes:-0} / 1048576 ))
}

kill_tree() {
  local pid="$1"
  pkill -P "$pid" 2>/dev/null
  kill "$pid" 2>/dev/null
  sleep 1
  pkill -9 -P "$pid" 2>/dev/null
  kill -9 "$pid" 2>/dev/null
  return 0
}

# run_gated <label> <timeout-seconds> <cmd...>
# Runs cmd under the memory watchdog + wall-clock timeout. Returns the
# command's rc, 124 on timeout, 137 on a pressure kill.
run_gated() {
  local label="$1" timeout="${GATE_TIMEOUT:-$2}"
  shift 2
  if [[ "$DRYRUN" = "1" ]]; then
    echo "gate DRYRUN [$label] (timeout ${timeout}s): $*"
    return 0
  fi
  echo "gate: [$label] starting (timeout ${timeout}s, watchdog every ${WATCH_INTERVAL}s)"
  "$@" &
  local pid=$!
  trap 'kill_tree '"$pid"'; exit 130' INT TERM
  local start=$SECONDS strikes=0 reason=""
  while kill -0 "$pid" 2>/dev/null; do
    sleep "$WATCH_INTERVAL"
    kill -0 "$pid" 2>/dev/null || break
    if (( SECONDS - start > timeout )); then
      reason="timeout after ${timeout}s"
      kill_tree "$pid"
      wait "$pid" 2>/dev/null
      echo "gate: [$label] KILLED — $reason" >&2
      trap - INT TERM
      return 124
    fi
    # Footprint ceiling: any single process in the gated tree crossing the
    # ceiling kills the run — pressure can stay nominal while one test host
    # accretes 15GB+ of dirty MALLOC_SMALL (2026-07-29 run 4).
    # Per-phase override: a clean build's compiler tree legitimately peaks
    # above the test-phase ceiling even at -jobs 4 (first real run: killed at
    # 4176MB mid-compile). Callers set GATE_FOOTPRINT_OVERRIDE_MB per phase;
    # the strict default still guards every test phase.
    local ceiling="${GATE_FOOTPRINT_OVERRIDE_MB:-${GATE_FOOTPRINT_MB:-4096}}" fp
    fp="$(tree_max_footprint_mb "$pid")"
    case "$fp" in ''|*[!0-9]*) fp=0 ;; esac
    if (( fp > ceiling )); then
      reason="process footprint ${fp}MB exceeded ceiling ${ceiling}MB"
      kill_tree "$pid"
      wait "$pid" 2>/dev/null
      echo "gate: [$label] KILLED — $reason" >&2
      trap - INT TERM
      return 137
    fi
    local level
    level="$(pressure_level)"
    case "$level" in
      ''|*[!0-9]*) level=1 ;;
    esac
    if (( level >= 4 )); then
      reason="memory pressure level $level (hard critical) — instant kill"
      kill_tree "$pid"
      wait "$pid" 2>/dev/null
      echo "gate: [$label] KILLED — $reason" >&2
      trap - INT TERM
      return 137
    elif (( level == 3 )); then
      strikes=$((strikes + 1))
      echo "gate: [$label] memory pressure level 3 — strike $strikes/2" >&2
      if (( strikes >= 2 )); then
        reason="memory pressure level 3 twice in a row"
        kill_tree "$pid"
        wait "$pid" 2>/dev/null
        echo "gate: [$label] KILLED — $reason" >&2
        trap - INT TERM
        return 137
      fi
    else
      strikes=0
    fi
  done
  wait "$pid"
  local rc=$?
  trap - INT TERM
  echo "gate: [$label] finished rc=$rc"
  return "$rc"
}

# --------------------------- area resolution --------------------------------
# resolve_area <name> → sets AREA_ONLY_TESTING (array of -only-testing:...)
# and AREA_ENGINE_PATHS (array of pytest paths). Errors on unknown area.
resolve_area() {
  local name="$1" row prefixes engine_globs
  row="$(area_table | awk -F'|' -v a="$name" '$1 ~ "^"a"[ ]*$" {print; exit}')"
  [[ -n "$row" ]] || die "unknown area '$name' — known: $(area_table | awk -F'|' '{printf "%s ", $1}')"
  prefixes="$(echo "$row" | awk -F'|' '{print $2}' | tr -d ' ')"
  engine_globs="$(echo "$row" | awk -F'|' '{print $3}' | sed 's/^ *//;s/ *$//')"
  AREA_ONLY_TESTING=()
  AREA_FILES=()
  # Recursive: the test tree mirrors the app structure (#4247), so prefixes
  # must match at any depth — a top-level glob resolves to NOTHING and a
  # vacuously green gate, the exact silent-skip class this harness exists
  # to kill.
  local prefix file klass
  IFS=',' read -ra _prefixes <<<"$prefixes"
  for prefix in "${_prefixes[@]}"; do
    [[ -n "$prefix" ]] || continue
    while IFS= read -r file; do
      [[ -n "$file" ]] || continue
      klass="$(basename "$file" .swift)"
      AREA_ONLY_TESTING+=("-only-testing:FicheroTests/$klass")
      AREA_FILES+=("$file")
    done < <(find "$SWIFT_TESTS_DIR" -type f -name "${prefix}*.swift" | sort)
  done
  AREA_ENGINE_PATHS=()
  local g p
  for g in $engine_globs; do
    for p in $g; do  # glob expansion
      [[ -e "$p" ]] && AREA_ENGINE_PATHS+=("$p")
    done
  done
}

# --------------------------- gate part --------------------------------------
#
# Verify ONE part of the app the way the release gate verifies all of it:
# lint, build, tests, and the performance ratchet — scoped to an area (#4439).
#
# The point is that "does my change hold up?" should be answerable in minutes
# against the part you touched, not only in an hour against everything. The
# checks are the same ones the full gate runs; only the scope differs, so a
# green `gate part` means the same thing here that it means there.
cmd_part() {
  local area="${1:-}"
  [[ -n "$area" ]] || die "usage: gate part <area>   (see: gate areas)"
  resolve_area "$area"

  local failed=0
  local -a LEG_NAMES=() LEG_RCS=() LEG_SECS=()
  echo "=== gate part: $area ==="

  # Self-test-only seam (#4451), mirroring GATE_FAKE_PRESSURE /
  # GATE_FAKE_FOOTPRINT_MB below: injects one deliberately-failing leg and
  # skips the real (slow) legs, so --self-test can prove a red leg actually
  # makes `gate part` exit nonzero without paying for a real lint+build+test
  # run. This is the exact path that silently exited 0 before this fix.
  if [[ "${GATE_FAKE_PART_LEG_FAIL:-0}" = "1" ]]; then
    run_leg "self-test-fake-fail" false || failed=1
    echo
    echo "==================== gate part '$area' summary ===================="
    local i
    for i in "${!LEG_NAMES[@]}"; do
      local verdict="PASS"
      [[ "${LEG_RCS[$i]}" -ne 0 ]] && { verdict="FAIL(rc=${LEG_RCS[$i]})"; failed=1; }
      printf "%-14s %-8s %ss\n" "${LEG_NAMES[$i]}" "$verdict" "${LEG_SECS[$i]}"
    done
    return $failed
  fi

  # 1. Lint. Whole-tree: swiftlint and ruff are seconds, and a scoped lint that
  #    misses a violation elsewhere in the same file is worse than useless.
  run_leg "lint" run_gated "part-lint" 600 bash -c \
    'swiftlint lint --quiet --config .swiftlint.yml fichero/fichero && ruff check fichero-server/src' \
    || failed=1

  # 1b. Every architecture/tooling guardrail (#4425): `verify_all.sh --fast`
  #     already glob-runs every `scripts/check_*.py`, but that's the FULL
  #     gate the no-lane-builds rule took away from workers; `gate part`'s
  #     own lint leg never called any of them, despite its doc comment's
  #     claim to run "the same checks the full gate runs". First landed
  #     scoped to two named scripts while three others were red for
  #     unrelated reasons (docs paths, docs publication, vacuous-test
  #     detection) — all three triaged and fixed in the same pass as this
  #     widening, so the full sweep is a one-line loop now, not a landmine.
  #     Same two exclusions `verify_all.sh` uses: `check_unmerged_work.py`
  #     is explicitly manager-only (dirty-worktree state, not a per-commit
  #     gate, per its own docstring); `check_emit_change_coverage.py` just
  #     runs in its own step rather than the loop, matching verify_all's
  #     ordering exactly so the two never drift apart silently.
  local part_py guardrail
  part_py="$(find_python)"
  for guardrail in scripts/check_*.py; do
    case "$(basename "$guardrail")" in
      check_unmerged_work.py|check_emit_change_coverage.py) continue ;;
    esac
    run_leg "$(basename "$guardrail" .py)" run_gated "part-$(basename "$guardrail" .py)" 90 \
      "$part_py" "$guardrail" \
      || failed=1
  done
  run_leg "check_emit_change_coverage" run_gated "part-check_emit_change_coverage" 90 \
    "$part_py" scripts/check_emit_change_coverage.py \
    || failed=1

  # 2. Build. Swift tests cannot run without it, and a part that does not
  #    compile is not verified whatever its tests say.
  run_leg "build" cmd_build || failed=1

  # 3. Swift unit tests for this area.
  if [[ ${#AREA_ONLY_TESTING[@]} -gt 0 ]]; then
    run_leg "swift-unit" cmd_unit --area "$area" || failed=1
  else
    echo "  (no Swift tests in area '$area')"
  fi

  # 4. Engine tests for this area, WITH the perf ratchet armed: every test is
  #    timed and held to its best, so a slowdown in the part you touched shows
  #    up here rather than waiting for the full perf leg.
  if [[ ${#AREA_ENGINE_PATHS[@]} -gt 0 ]]; then
    run_leg "engine+perf" env FICHERO_PERF_RATCHET=1 bash -c \
      "cd '$REPO_ROOT' && scripts/gate engine --area '$area'" || failed=1
  else
    echo "  (no engine tests in area '$area')"
  fi

  echo
  echo "==================== gate part '$area' summary ===================="
  local i
  for i in "${!LEG_NAMES[@]}"; do
    local verdict="PASS"
    # run_leg always `return 0` (correct for cmd_verify_all, whose OWN summary
    # loop below sets `fail=1` from LEG_RCS) — so the `|| failed=1` on every
    # run_leg call above never fires; without setting `failed` HERE too, a
    # failing leg prints FAIL in this table and `gate part` still exits 0
    # (#4451, found right after #4451's own sibling fix landed run_leg at
    # top level — a leg not firing and a leg firing-but-not-failing are two
    # different bugs).
    [[ "${LEG_RCS[$i]}" -ne 0 ]] && { verdict="FAIL(rc=${LEG_RCS[$i]})"; failed=1; }
    printf "%-14s %-8s %ss\n" "${LEG_NAMES[$i]}" "$verdict" "${LEG_SECS[$i]}"
  done
  return $failed
}

cmd_areas() {
  if [[ $# -eq 0 ]]; then
    echo "gate areas:"
    area_table | awk -F'|' '{printf "  %-10s swift-prefixes:%-35s engine:%s\n", $1, $2, $3}'
    return 0
  fi
  resolve_area "$1"
  echo "area $1:"
  local x
  for x in ${AREA_ONLY_TESTING[@]+"${AREA_ONLY_TESTING[@]}"}; do echo "  $x"; done
  for x in ${AREA_ENGINE_PATHS[@]+"${AREA_ENGINE_PATHS[@]}"}; do echo "  engine: $x"; done
  [[ ${#AREA_ONLY_TESTING[@]} -gt 0 || ${#AREA_ENGINE_PATHS[@]} -gt 0 ]] || {
    echo "  (area resolved to NOTHING — prefixes matched no files)" >&2
    return 1
  }
}

# --------------------------- subcommands ------------------------------------
xcode_build_for_testing() {
  GATE_FOOTPRINT_OVERRIDE_MB="${GATE_FOOTPRINT_BUILD_MB:-8192}" \
  run_gated "build-for-testing" "${GATE_TIMEOUT_BUILD:-3600}" \
    xcodebuild -project "$XCODE_PROJECT" -scheme "$UNIT_SCHEME" \
      -destination 'platform=macOS' -derivedDataPath "$GATE_DERIVED" \
      -jobs 4 -skipPackagePluginValidation build-for-testing
}

cmd_build() { xcode_build_for_testing; }

# Candidate unit-test FILES for the given --area/--filter (all files when
# neither is given). Echoes paths, one per line.
unit_candidate_files() {
  local area="$1" filter="$2" file prefix
  if [[ -n "$area" ]]; then
    resolve_area "$area"
    local x
    for x in ${AREA_FILES[@]+"${AREA_FILES[@]}"}; do echo "$x"; done
  elif [[ -n "$filter" ]]; then
    find "$SWIFT_TESTS_DIR" -type f -name "${filter}*.swift" | sort
  else
    find "$SWIFT_TESTS_DIR" -type f -name "*.swift" | sort
  fi
}

# One separately-bounded test invocation.
# $1 = phase label, $2 = SWT_SWIFT_TESTING_ENABLED value (0|1),
# $3.. = extra xcodebuild args (-only-testing:... filters).
run_unit_phase() {
  local phase="$1" swt="$2"; shift 2
  # TEST_RUNNER_ vars propagate into the test host: hermetic engine (#4246) —
  # never reuse a dev engine on :8765; always self-provision + tear down.
  run_gated "unit-$phase" "${GATE_TIMEOUT_TEST:-3600}" \
    env TEST_RUNNER_FICHERO_HERMETIC_ENGINE=1 \
        "TEST_RUNNER_SWT_SWIFT_TESTING_ENABLED=$swt" \
    xcodebuild -project "$XCODE_PROJECT" -scheme "$UNIT_SCHEME" \
      -destination 'platform=macOS' -derivedDataPath "$GATE_DERIVED" \
      -skipPackagePluginValidation "$@" test-without-building
}

cmd_unit() {
  local area="" filter="" phase="all"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --area) area="$2"; shift 2 ;;
      --filter) filter="$2"; shift 2 ;;
      --phase) phase="$2"; shift 2 ;;   # xctest | swift-testing | all
      *) die "unit: unknown arg $1" ;;
    esac
  done
  case "$phase" in xctest|swift-testing|all) ;; *) die "unit: --phase must be xctest|swift-testing|all" ;; esac

  local files
  files="$(unit_candidate_files "$area" "$filter")"
  [[ -n "$files" ]] || die "unit: no test files matched (area='$area' filter='$filter')"

  # Split the candidate files by framework so the XCTest and Swift Testing
  # phases run as SEPARATELY-bounded invocations — one leaking phase cannot
  # ride on (or hide inside) the other's watchdog budget.
  local xctest_only=() swt_only=() f stem
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    stem="$(basename "$f" .swift)"
    if grep -q "XCTestCase" "$f"; then
      xctest_only+=("-only-testing:FicheroTests/$stem")
    fi
    if grep -q "^import Testing" "$f"; then
      swt_only+=("-only-testing:FicheroTests/$stem")
    fi
  done <<<"$files"

  # Phase 0: build (jobs capped), then test WITHOUT building. Never stacked —
  # that stacking is one of the crash shapes this script exists for.
  xcode_build_for_testing || return $?

  local rc=0
  if [[ "$phase" == "xctest" || "$phase" == "all" ]]; then
    if [[ ${#xctest_only[@]} -gt 0 ]]; then
      # Full-suite runs pass no -only-testing list (hundreds of entries slow
      # xcodebuild's scheduler); Swift Testing is disabled via its env switch
      # so this invocation is XCTest-only either way.
      if [[ -z "$area" && -z "$filter" ]]; then
        run_unit_phase "xctest" 0 || rc=$?
      else
        run_unit_phase "xctest" 0 "${xctest_only[@]}" || rc=$?
      fi
    else
      echo "gate: unit-xctest — no XCTest files in selection, skipped"
    fi
  fi
  if [[ "$phase" == "swift-testing" || "$phase" == "all" ]]; then
    if [[ ${#swt_only[@]} -gt 0 ]]; then
      run_unit_phase "swift-testing" 1 "${swt_only[@]}" || rc=$?
    else
      echo "gate: unit-swift-testing — no Swift Testing files in selection, skipped"
    fi
  fi
  return "$rc"
}

cmd_engine() {
  # The ratchet is AUTOMATIC on the gate (#4445): every test is timed and
  # held to its best. Laptops stay silent unless someone opts in — a run
  # sharing a machine with a browser must not set bars others must meet.
  export FICHERO_PERF_RATCHET="${FICHERO_PERF_RATCHET:-1}"
  local paths=() area=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --area) area="$2"; shift 2 ;;
      *) paths+=("$1"); shift ;;
    esac
  done
  local py; py="$(find_python)"
  local args=()
  if [[ -n "$area" ]]; then
    resolve_area "$area"
    [[ ${#AREA_ENGINE_PATHS[@]} -gt 0 ]] || die "area '$area' has no engine tests"
    args=("${AREA_ENGINE_PATHS[@]}")
  elif [[ ${#paths[@]} -gt 0 ]]; then
    args=("${paths[@]}")
  else
    # Everyday leg: unit + integration + contracts. tests/perf is EXCLUDED by
    # construction (explicit paths, not the tree root) — the two scale tests
    # alone are ~50 min and belong to `gate perf` (#4271).
    args=(fichero-server/tests/unit/ --ignore=fichero-server/tests/unit/_archived
          fichero-server/tests/integration/
          fichero-server/tests/contracts/)
  fi
  run_gated "engine-pytest" "${GATE_TIMEOUT_ENGINE:-2700}" \
    env PYTHONPATH=fichero-server/src "$py" -m pytest -rf "${args[@]}"
}

cmd_perf() {
  export FICHERO_PERF_RATCHET="${FICHERO_PERF_RATCHET:-1}"
  # The deliberate scale suite (seed 100-image libraries, thousands of
  # entities, budget assertions). ~35-40 min; SLOW, not hung — two tests print
  # nothing for ~25 min each under -q (#4039), so stream with -rf and no -q.
  local py; py="$(find_python)"
  local args=("$@")
  [[ ${#args[@]} -gt 0 ]] || args=(fichero-server/tests/perf/)
  run_gated "perf-pytest" "${GATE_TIMEOUT_PERF:-5400}" \
    env PYTHONPATH=fichero-server/src "$py" -m pytest -rf "${args[@]}"
}

cmd_ui() {
  local plan="${1:?gate ui <testplan> (e.g. fichero, fichero-embedded)}"
  # The UI leg legitimately stacks three footprints (in-invocation build,
  # hosted unit suite, UI runner + app) — first real run brushed 4208MB with
  # no leak. 6144 default still catches the 13GB+ runaway class.
  GATE_FOOTPRINT_OVERRIDE_MB="${GATE_FOOTPRINT_UI_MB:-6144}" \
  run_gated "ui-$plan" "${GATE_TIMEOUT_UI:-5400}" \
    xcodebuild -project "$XCODE_PROJECT" -scheme "$UI_SCHEME" \
      -testPlan "$plan" -destination 'platform=macOS' \
      -skipPackagePluginValidation \
      -resultBundlePath "$(mktemp -d)/gate-$plan.xcresult" test
}

cmd_ios() {
  # iOS COMPILE gate, device-less. Daniel, 2026-08-02: "we need to do iOS and
  # iPad test individually."
  #
  # This existed only inside `verify_all.sh --full`, which is why BOTH #4331
  # (iOS TestFlight crashing at launch) and #4418 (a root view chain that
  # type-checked on macOS and timed out on iOS) reached an archive. macOS
  # compiling proves nothing about iOS: the type-checker budget is tighter and
  # AppKit-gated code is invisible to it.
  #
  # Generic destination on purpose — no simulator is booted or named, so this
  # runs headless and cannot depend on whatever devices this machine has.
  GATE_FOOTPRINT_OVERRIDE_MB="${GATE_FOOTPRINT_IOS_MB:-8192}" \
  run_gated "ios-compile" "${GATE_TIMEOUT_IOS:-3600}" \
    xcodebuild -project "$XCODE_PROJECT" -scheme "$UNIT_SCHEME" \
      -destination 'generic/platform=iOS Simulator' \
      -derivedDataPath "$GATE_DERIVED/ios" \
      -skipPackagePluginValidation build
}

cmd_ipad() {
  # iPad leg. `fichero-ipad.xctestplan` has existed for some time and was wired
  # into NOTHING — `scripts/gate` did not mention iPad at all before this.
  #
  # iPad is not "iOS on a bigger screen" for this app: it is where the
  # multi-column layout, the inspector and the canvas actually get exercised,
  # and where a NavigationSplitView behaves differently from either sibling.
  #
  # Needs a booted simulator, so this leg is OPT-IN via GATE_IPAD_DESTINATION
  # rather than guessing a device name that may not exist on this machine.
  # Absent that, it reports NOT ARMED (exit 0) rather than blind — the
  # distinction AGENTS.md draws: inputs legitimately missing is not the same as
  # a check that cannot see.
  local dest="${GATE_IPAD_DESTINATION:-}"
  if [[ -z "$dest" ]]; then
    echo "gate: ipad NOT ARMED — set GATE_IPAD_DESTINATION to a booted simulator," >&2
    echo "gate:   e.g. GATE_IPAD_DESTINATION='platform=iOS Simulator,name=iPad Pro 13-inch (M4)'" >&2
    echo "gate:   list with: xcrun simctl list devices available | grep iPad" >&2
    return 0
  fi
  GATE_FOOTPRINT_OVERRIDE_MB="${GATE_FOOTPRINT_IPAD_MB:-8192}" \
  run_gated "ipad-tests" "${GATE_TIMEOUT_IPAD:-5400}" \
    xcodebuild -project "$XCODE_PROJECT" -scheme "$UI_SCHEME" \
      -testPlan fichero-ipad -destination "$dest" \
      -derivedDataPath "$GATE_DERIVED/ipad" \
      -skipPackagePluginValidation \
      -resultBundlePath "$(mktemp -d)/gate-ipad.xcresult" test
}

cmd_embedded() {
  run_gated "embedded-launch" "${GATE_TIMEOUT_EMBEDDED:-3600}" \
    bash scripts/verify_embedded_launch.sh
}

cmd_transport() {
  # Python leg: the full round-trip matrix over UDS / HTTPS / in-memory ASGI
  # (#4245). Swift leg: the .inMemory PythonKit transport under swift test —
  # the acceptance test for the transport nobody was sure worked.
  local py rc=0; py="$(find_python)"
  run_gated "transport-python" "${GATE_TIMEOUT_TRANSPORT:-1800}" \
    env PYTHONPATH=fichero-server/src "$py" -m pytest -rf \
      fichero-server/tests/integration/test_transport_matrix.py \
      fichero-server/tests/integration/test_transport_round_trips.py || rc=$?
  run_gated "transport-swift-inmemory" "${GATE_TIMEOUT_TRANSPORT:-1800}" \
    swift test --package-path fichero/fichero-api-client \
      --filter 'InMemoryTransportSmokeTests|TransportRoutingMatrixTests|TransportMatrixRoundTripTests' || rc=$?
  return "$rc"
}

cmd_coverage() {
  local py; py="$(find_python)"
  [[ -f scripts/scan_test_coverage_gaps.py ]] || { echo "gate: no coverage ratchet script"; return 0; }
  run_gated "coverage" "${GATE_TIMEOUT_COVERAGE:-900}" \
    "$py" scripts/scan_test_coverage_gaps.py
}

cmd_wrap() {
  [[ "${1:-}" == "--" ]] && shift
  [[ $# -gt 0 ]] || die "wrap: no command given (gate wrap -- <cmd...>)"
  run_gated "wrap:$1" "${GATE_TIMEOUT_WRAP:-7200}" "$@"
}

# run_leg — shared by cmd_verify_all AND cmd_part (#4449 fix): both record a
# leg's name/rc/elapsed into LEG_NAMES/LEG_RCS/LEG_SECS, which each caller
# must declare `local -a` before its first run_leg call (bash's dynamic
# scoping resolves run_leg's unqualified array names to the caller's
# locals). Previously nested INSIDE cmd_verify_all, so `gate part <area>`
# hit "run_leg: command not found" on every invocation — undetected because
# nothing exercised `gate part` until a worker actually tried it.
run_leg() {
  local name="$1"; shift
  local t0=$SECONDS
  echo
  echo "================ gate leg: $name ================"
  "$@"
  local rc=$?
  LEG_NAMES+=("$name"); LEG_RCS+=("$rc"); LEG_SECS+=($((SECONDS - t0)))
  # Return the LEG's status, not 0.
  #
  # This used to `return 0` so verify-all could keep going and aggregate at the
  # end — which is right for verify-all, and it re-reads LEG_RCS itself. But
  # cmd_part uses `|| failed=1`, and against an always-0 return every one of
  # those handlers was dead code: a failing lint or build printed FAIL(rc=N) in
  # the table while `gate part` exited 0.
  #
  # A gate that prints a failure and exits green is worse than one that crashes,
  # because a crash gets noticed. Callers that want to continue past a failure
  # say so explicitly with `|| true`.
  return $rc
}

# --------------------------- verify-all (#4251) -----------------------------
cmd_verify_all() {
  local -a LEG_NAMES=() LEG_RCS=() LEG_SECS=()

  # guardrails leg: verify_all.sh --fast (swiftlint + ruff + check_*.py +
  # version-date + OpenAPI sync). FICHERO_GATE=1 stops it re-wrapping itself.
  run_leg "guardrails"  run_gated "guardrails" "${GATE_TIMEOUT_GUARDRAILS:-1800}" \
    env FICHERO_GATE=1 bash scripts/verify_all.sh --fast
  # ORDER MATTERS: cheapest and most-likely-to-fail first, slowest last.
  #
  # perf used to run third, at ~51 minutes, ahead of the Swift legs — so a
  # Swift compile error was reported an hour after it could have been. Nothing
  # about a performance number is worth knowing while the code does not build
  # or the logic is wrong, and a broken build makes the timings meaningless
  # anyway.
  #
  # So: lint (in guardrails, seconds) -> does it build and are the unit tests
  # right -> backend logic -> integration -> and only then, how fast is it.
  run_leg "swift-unit"    cmd_unit
  # iOS compiles BEFORE the slow legs. Both #4331 and #4418 reached an archive
  # because this only ran at `verify_all --full`, and macOS compiling proves
  # nothing about iOS — tighter type-checker budget, and AppKit-gated code is
  # invisible from a Mac build.
  run_leg "ios-compile"   cmd_ios
  run_leg "ipad"          cmd_ipad
  run_leg "engine"        cmd_engine
  run_leg "transport"     cmd_transport
  run_leg "ui-hermetic"   cmd_ui fichero
  run_leg "coverage"      cmd_coverage
  # LAST, and REQUIRED in verify-all (release gate); only the everyday
  # `gate engine` leg dropped it (#4271). ~51 min on its own.
  run_leg "perf"          cmd_perf

  echo
  echo "==================== gate verify-all summary ===================="
  printf "%-14s %-8s %s\n" "LEG" "RESULT" "TIME"
  local i fail=0
  for i in "${!LEG_NAMES[@]}"; do
    local verdict="PASS"
    [[ "${LEG_RCS[$i]}" -ne 0 ]] && { verdict="FAIL(rc=${LEG_RCS[$i]})"; fail=1; }
    printf "%-14s %-8s %ss\n" "${LEG_NAMES[$i]}" "$verdict" "${LEG_SECS[$i]}"
  done
  echo "================================================================="
  if [[ "$fail" -eq 0 ]]; then
    echo "gate verify-all: ALL PASS — releasable"
  else
    echo "gate verify-all: FAILED — not releasable"
  fi
  return "$fail"
}

# --------------------------- self-test --------------------------------------
cmd_self_test() {
  echo "gate --self-test"
  local tmp fails=0
  tmp="$(mktemp -d)"

  check() { # name condition-rc
    local name="$1" rc="$2"
    if [[ "$rc" -eq 0 ]]; then echo "  ok   $name"; else echo "  FAIL $name"; fails=1; fi
  }

  # 1. Area resolution: sidebar resolves to Swift classes, ingest to both
  #    kinds, unknown area errors.
  local out
  out="$("$0" areas sidebar 2>&1)"; local rc=$?
  [[ $rc -eq 0 && "$out" == *"-only-testing:FicheroTests/Sidebar"* ]]; check "area sidebar resolves to -only-testing filters" $?
  out="$("$0" areas ingest 2>&1)"
  [[ "$out" == *"engine: fichero-server/tests/unit/importers/"* ]]; check "area ingest resolves engine paths" $?
  "$0" areas no-such-area >/dev/null 2>&1; [[ $? -ne 0 ]]; check "unknown area is a hard error" $?

  # 2. Dry-run command assembly: unit --area sidebar must show the capped
  #    build phase plus a separately-bounded XCTest test phase.
  out="$(GATE_DRYRUN=1 "$0" unit --area sidebar 2>&1)"
  [[ "$out" == *"build-for-testing"* && "$out" == *"test-without-building"* ]]
  check "unit = build phase then test-without-building (dry-run)" $?
  [[ "$out" == *"-jobs 4"* ]]; check "build phase caps -jobs" $?
  [[ "$out" == *"[unit-xctest]"* && "$out" == *"SWT_SWIFT_TESTING_ENABLED=0"* ]]
  check "unit: XCTest phase is its own bounded invocation (Swift Testing off)" $?
  [[ "$out" == *"TEST_RUNNER_FICHERO_HERMETIC_ENGINE=1"* ]]
  check "unit: hermetic-engine env reaches the test host (#4246)" $?

  # 2b. Perf split (#4271): `engine` must exclude tests/perf; `perf` must run it.
  out="$(GATE_DRYRUN=1 "$0" engine 2>&1)"
  [[ "$out" != *"tests/perf"* && "$out" == *"fichero-server/tests/unit/"* \
     && "$out" == *"fichero-server/tests/integration/"* ]]
  check "engine leg = unit+integration+contracts, NO tests/perf (dry-run)" $?
  out="$(GATE_DRYRUN=1 "$0" perf 2>&1)"
  [[ "$out" == *"[perf-pytest]"* && "$out" == *"fichero-server/tests/perf/"* ]]
  check "perf leg runs tests/perf as its own bounded invocation (dry-run)" $?

  # 2b2. `gate part` (#4425): the FULL `scripts/check_*.py` sweep actually
  #      runs, in order, before the build leg — not just two named scripts
  #      (the initial, deliberately narrow landing, widened once the three
  #      guardrails blocking it were triaged green) and not just defined
  #      somewhere and never called. Checks a script from EACH end of the
  #      alphabetical glob plus one wholly unrelated to the original two
  #      named scripts, so this can't pass by coincidentally still matching
  #      the old narrower assertion. DRYRUN prints every leg's command
  #      instead of running it (confirmed: no `xcodebuild` line appears
  #      before them), so this is real coverage of the wiring, not a claim
  #      about it.
  out="$(GATE_DRYRUN=1 "$0" part sidebar 2>&1)"
  [[ "$out" == *"check_accessibility.py"* \
     && "$out" == *"check_naive_datetimes.py"* \
     && "$out" == *"check_xcode_registration.py"* \
     && "$out" == *"check_emit_change_coverage.py"* ]]
  check "gate part: the full check_*.py sweep is invoked, not two scripts" $?
  # check_unmerged_work.py is explicitly excluded (manager-only, dirty-worktree
  # state, not a per-commit gate) — the same exclusion verify_all.sh makes.
  [[ "$out" != *"check_unmerged_work.py"* ]]
  check "gate part: check_unmerged_work.py stays excluded, matching verify_all.sh" $?
  before_build="${out%%xcodebuild*}"
  [[ "$before_build" == *"check_accessibility.py"* && "$before_build" == *"check_xcode_registration.py"* ]]
  check "gate part: the guardrail sweep runs before the build leg" $?

  # 2c. `gate part` (#4451): a red leg must make the command exit nonzero,
  #     not just print FAIL and exit 0. Uses the GATE_FAKE_PART_LEG_FAIL seam
  #     so this stays fast — no real lint/build/test run.
  out="$(GATE_DRYRUN=1 GATE_FAKE_PART_LEG_FAIL=1 "$0" part sidebar 2>&1)"; rc=$?
  [[ "$out" == *"self-test-fake-fail"* && "$out" == *"FAIL(rc="* ]]
  check "gate part: summary table names the failing leg" $?
  [[ $rc -ne 0 ]]; check "gate part: a red leg makes the command exit nonzero (#4451)" $?

  # 2d. Free-space preflight (#4434): must FIRE when the volume is below the
  #     threshold (driven via GATE_MIN_FREE_GB, both directions) and must fire
  #     BEFORE the lock — a run that will die on a full disk must not queue.
  GATE_MIN_FREE_GB=999999 "$0" preflight >/dev/null 2>&1
  [[ $? -ne 0 ]]; check "preflight: refuses when free space is below the bar (#4434)" $?
  GATE_MIN_FREE_GB=0 "$0" preflight >/dev/null 2>&1
  check "preflight: passes when the bar is met" $?
  out="$(env -u GATE_LOCK_HELD GATE_MIN_FREE_GB=999999 "$0" wrap -- true 2>&1)"; rc=$?
  [[ $rc -ne 0 && "$out" == *"PREFLIGHT REFUSED"* && "$out" != *"waiting for lock"* ]]
  check "preflight: a heavy subcommand refuses pre-lock on a full disk (#4434)" $?

  # 3. Lock contention: hold the lock with a trivial sleep, then a --no-wait
  #    caller must fail fast with 75, and a waiting caller must queue+succeed.
  #    (env -u GATE_LOCK_HELD: the self-test itself runs under the real gate
  #    lock; these sub-calls must contend on their OWN lock file.)
  local lock="$tmp/gate.lock"
  env -u GATE_LOCK_HELD GATE_LOCK_FILE="$lock" "$0" wrap -- sleep 3 &
  local holder=$!
  sleep 1
  env -u GATE_LOCK_HELD GATE_LOCK_FILE="$lock" "$0" --no-wait wrap -- true >/dev/null 2>&1
  [[ $? -eq 75 ]]; check "second caller with --no-wait fails fast (exit 75)" $?
  local t0=$SECONDS
  env -u GATE_LOCK_HELD GATE_LOCK_FILE="$lock" "$0" wrap -- true >/dev/null 2>&1
  rc=$?
  [[ $rc -eq 0 && $((SECONDS - t0)) -ge 1 ]]; check "waiting caller queues until holder exits, then runs" $?
  wait "$holder" 2>/dev/null

  # 4. Watchdog: hard-critical pressure (level 4) kills a fake command fast.
  local pfile="$tmp/pressure"
  echo 1 >"$pfile"
  ( sleep 1; echo 4 >"$pfile" ) &
  env -u GATE_LOCK_HELD GATE_LOCK_FILE="$tmp/wd1.lock" GATE_FAKE_PRESSURE="$pfile" GATE_WATCH_INTERVAL=0.3 \
    "$0" wrap -- sleep 30 >/dev/null 2>&1
  [[ $? -eq 137 ]]; check "watchdog: instant kill at pressure level >= 4 (rc 137)" $?

  # 5. Watchdog: two-strike at level 3 (one strike alone must NOT kill).
  echo 3 >"$pfile"
  env -u GATE_LOCK_HELD GATE_LOCK_FILE="$tmp/wd2.lock" GATE_FAKE_PRESSURE="$pfile" GATE_WATCH_INTERVAL=0.3 \
    "$0" wrap -- sleep 30 >/dev/null 2>&1
  [[ $? -eq 137 ]]; check "watchdog: two-strike kill at sustained level 3 (rc 137)" $?
  echo 1 >"$pfile"
  ( sleep 0.35; echo 3 >"$pfile"; sleep 0.3; echo 1 >"$pfile" ) &
  env -u GATE_LOCK_HELD GATE_LOCK_FILE="$tmp/wd3.lock" GATE_FAKE_PRESSURE="$pfile" GATE_WATCH_INTERVAL=0.3 \
    "$0" wrap -- sleep 2 >/dev/null 2>&1
  [[ $? -eq 0 ]]; check "watchdog: a single level-3 strike does not kill" $?

  # 6. Watchdog: footprint ceiling — a process crossing GATE_FOOTPRINT_MB is
  #    killed even while pressure stays nominal (the run-4 leak shape).
  local ffile="$tmp/footprint"
  echo 100 >"$ffile"
  ( sleep 1; echo 9999 >"$ffile" ) &
  env -u GATE_LOCK_HELD GATE_LOCK_FILE="$tmp/wd4.lock" GATE_FAKE_FOOTPRINT_MB="$ffile" \
    GATE_FOOTPRINT_MB=4096 GATE_WATCH_INTERVAL=0.3 \
    "$0" wrap -- sleep 30 >/dev/null 2>&1
  [[ $? -eq 137 ]]; check "watchdog: footprint over ceiling kills (rc 137)" $?
  echo 100 >"$ffile"
  env -u GATE_LOCK_HELD GATE_LOCK_FILE="$tmp/wd5.lock" GATE_FAKE_FOOTPRINT_MB="$ffile" \
    GATE_FOOTPRINT_MB=4096 GATE_WATCH_INTERVAL=0.3 \
    "$0" wrap -- sleep 1 >/dev/null 2>&1
  [[ $? -eq 0 ]]; check "watchdog: footprint under ceiling does not kill" $?

  # 7. Timeout kills a fake command with rc 124.
  env -u GATE_LOCK_HELD GATE_LOCK_FILE="$tmp/to.lock" GATE_TIMEOUT=1 GATE_WATCH_INTERVAL=0.3 \
    "$0" wrap -- sleep 30 >/dev/null 2>&1
  [[ $? -eq 124 ]]; check "per-run timeout kills (rc 124)" $?

  # 8. Reentrancy: a nested gate call under a held lock must not deadlock.
  env -u GATE_LOCK_HELD GATE_LOCK_FILE="$tmp/re.lock" \
    "$0" wrap -- "$0" --no-wait wrap -- true >/dev/null 2>&1
  [[ $? -eq 0 ]]; check "nested gate call re-enters the held lock (no deadlock)" $?

  rm -rf "$tmp"
  if [[ "$fails" -eq 0 ]]; then echo "gate --self-test: ALL PASS"; else echo "gate --self-test: FAILURES" >&2; fi
  return "$fails"
}

# --------------------------- main -------------------------------------------
usage() { sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; }

# Parse global flags before the subcommand.
NO_WAIT=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-wait) NO_WAIT=1; shift ;;
    --self-test) SUBCMD="self-test"; shift; break ;;
    -h|--help) usage; exit 0 ;;
    *) SUBCMD="$1"; shift; break ;;
  esac
done
[[ -n "${SUBCMD:-}" ]] || { usage; exit 2; }

# 'areas' is metadata-only: no lock, no watchdog — safe while a run is live.
if [[ "$SUBCMD" == "areas" ]]; then cmd_areas "$@"; exit $?; fi
# 'preflight' reports the free-space verdict and takes no lock — safe while a
# run is live, and how the self-test drives both directions (#4434).
if [[ "$SUBCMD" == "preflight" ]]; then preflight_free_space; exit $?; fi

# Refuse BEFORE queueing on the lock: a run that will die on a full disk must
# not hold every other lane hostage first (#4434). Top-level invocations only —
# verify-all's nested legs inherit the parent's verdict. self-test exempt: it
# exercises the preflight explicitly in both directions.
if [[ -z "${GATE_LOCK_HELD:-}" && "$SUBCMD" != "self-test" ]]; then
  preflight_free_space || die "free-space preflight failed — clear disk before running the gate (#4434)"
fi

if [[ -z "${GATE_LOCK_HELD:-}" ]]; then
  export GATE_NO_WAIT="$NO_WAIT"
  acquire_lock_and_reexec "$SUBCMD" "$@"
  # exec never returns
fi
announce_holder "$SUBCMD" "$@"

case "$SUBCMD" in
  build)      cmd_build "$@" ;;
  unit)       cmd_unit "$@" ;;
  engine)     cmd_engine "$@" ;;
  perf)       cmd_perf "$@" ;;
  part)       cmd_part "$@" ;;
  areas)      cmd_areas "$@" ;;
  ui)         cmd_ui "$@" ;;
  ios)        cmd_ios "$@" ;;
  ipad)       cmd_ipad "$@" ;;
  embedded)   cmd_embedded "$@" ;;
  transport)  cmd_transport "$@" ;;
  coverage)   cmd_coverage "$@" ;;
  verify-all) cmd_verify_all "$@" ;;
  wrap)       cmd_wrap "$@" ;;
  self-test)  cmd_self_test "$@" ;;
  *) die "unknown subcommand '$SUBCMD' (see gate --help)" ;;
esac
