<!DOCTYPE html>
<html lang="{{ site.lang or 'es' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ site.subtitle }}">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%97%83%EF%B8%8F%3C/text%3E%3C/svg%3E">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <link href="{{ site.base }}/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="{{ site.base }}/assets/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
  <link href="{{ site.base }}/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
  <link href="{{ site.base }}/assets/main.css" rel="stylesheet">
  <link href="{{ site.base }}/assets/catalogue.css" rel="stylesheet">
  {% if site.include_search %}<link href="{{ site.base }}/pagefind/pagefind-ui.css" rel="stylesheet">{% endif %}
</head>

<body class="index-page">
  <header>
    {% include "navbar.njk" %}
  </header>

  <main class="main">
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  {% if site.include_search %}
  <div id="search-modal" class="modal modal-xl" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Buscar en el catálogo</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <div id="search-modal-box" class="search"></div>
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <script src="{{ site.base }}/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="{{ site.base }}/assets/vendor/glightbox/js/glightbox.min.js"></script>
  {% if site.include_search %}<script src="{{ site.base }}/pagefind/pagefind-ui.js"></script>{% endif %}
  <script>window.SITE_HAS_SEARCH = {{ 'true' if site.include_search else 'false' }};</script>
  <script src="{{ site.base }}/assets/catalogue.js"></script>
</body>
</html>
