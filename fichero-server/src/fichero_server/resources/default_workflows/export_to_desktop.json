{
  "name": "Export to Desktop (MD + DOCX + XLSX)",
  "description": "Export the selected folder or whole library to the Desktop as a Markdown folder, a Word .docx, and an Excel .xlsx. No LLM required \u2014 runs entirely on the local export service.",
  "format": "nodes",
  "is_template": true,
  "is_system": true,
  "folder_path": "/Export",
  "tags": [
    "preset",
    "export",
    "markdown",
    "docx",
    "xlsx"
  ],
  "config": {
    "preset_version": 2
  },
  "nodes": [
    {
      "id": "files-source",
      "tool": "files",
      "label": "Files",
      "position_x": 80,
      "position_y": 200,
      "inputs": {},
      "config": {}
    },
    {
      "id": "export-documents",
      "tool": "export_documents",
      "label": "Export Documents",
      "position_x": 280,
      "position_y": 200,
      "inputs": {},
      "config": {
        "formats": [
          "markdown",
          "docx",
          "xlsx"
        ],
        "destination": "~/Desktop"
      }
    }
  ],
  "edges": [
    {
      "id": "edge-files-export",
      "source": "files-source",
      "target": "export-documents",
      "source_port": "documents",
      "target_port": "documents"
    }
  ]
}
