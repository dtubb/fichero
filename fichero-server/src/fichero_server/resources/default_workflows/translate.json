{
  "name": "Translate",
  "description": "Transcribe each file (reusing any existing text layer), then translate the extracted text into your preferred language using an LLM. Target language, source language, model, and prompt are all editable on the Translate node. The LLM node uses the $small model alias — set your default small model in Settings → AI Defaults.",
  "format": "nodes",
  "is_template": true,
  "is_system": true,
  "folder_path": "/Translate",
  "tags": ["preset", "translate", "text", "language", "small"],
  "config": {
    "preset_version": 2
  },
  "nodes": [
    {
      "id": "files-source",
      "tool": "files",
      "label": "Files",
      "position_x": 80,
      "position_y": 200,
      "inputs": {},
      "config": {}
    },
    {
      "id": "transcribe",
      "tool": "transcribe",
      "label": "Transcribe each file",
      "position_x": 280,
      "position_y": 200,
      "inputs": {},
      "config": {
        "vision_mode": "auto",
        "language": "auto",
        "update_page_content": true
      }
    },
    {
      "id": "text_translate",
      "tool": "text_translate",
      "label": "Translate Text",
      "position_x": 480,
      "position_y": 200,
      "inputs": {},
      "config": {
        "provider_name": "$small",
        "target_language": "English",
        "source_language": "auto",
        "preserve_names": true
      }
    }
  ],
  "edges": [
    {
      "id": "edge-files-transcribe",
      "source": "files-source",
      "target": "transcribe",
      "source_port": "files",
      "target_port": "files"
    },
    {
      "id": "edge-files-transcribe-documents",
      "source": "files-source",
      "target": "transcribe",
      "source_port": "documents",
      "target_port": "documents"
    },
    {
      "id": "edge-transcribe-translate",
      "source": "transcribe",
      "target": "text_translate",
      "source_port": "text",
      "target_port": "text"
    }
  ]
}
