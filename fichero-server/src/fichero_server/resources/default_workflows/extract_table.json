{
  "name": "Extract Table",
  "description": "Detect and extract tabular data from each image/page using vision, emitting CSV you can paste into a spreadsheet. Feeds the spreadsheet (Table) representation in the document viewer. The output style and header handling are editable on the Table node. A final Check Consistency step flags a figure that disagrees with its words and a name spelled two ways.",
  "format": "nodes",
  "is_template": true,
  "is_system": true,
  "folder_path": "/Extract",
  "tags": [
    "preset",
    "table",
    "extract",
    "representation"
  ],
  "config": {
    "preset_version": 4
  },
  "nodes": [
    {
      "id": "files-source",
      "tool": "files",
      "label": "Files",
      "position_x": 80,
      "position_y": 200,
      "inputs": {},
      "config": {}
    },
    {
      "id": "table",
      "tool": "table_extract",
      "label": "Extract Table",
      "position_x": 320,
      "position_y": 200,
      "inputs": {},
      "config": {
        "output_style": "csv",
        "include_headers": true
      }
    },
    {
      "id": "consistency",
      "tool": "consistency-check",
      "label": "Check Consistency",
      "position_x": 560,
      "position_y": 200,
      "inputs": {},
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "edge-files-table",
      "source": "files-source",
      "target": "table",
      "source_port": "files",
      "target_port": "files"
    },
    {
      "id": "edge-files-table-documents",
      "source": "files-source",
      "target": "table",
      "source_port": "documents",
      "target_port": "documents"
    },
    {
      "id": "edge-table-consistency",
      "source": "table",
      "target": "consistency",
      "source_port": "text",
      "target_port": "text"
    }
  ]
}
